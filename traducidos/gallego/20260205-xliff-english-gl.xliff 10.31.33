		<source><![CDATA[Facebook]]></source>
		<target><![CDATA[Facebook]]></target>
	</trans-unit>
	<trans-unit id="facebook_ed" extradata="app">
		<source><![CDATA[This app allows binding all the Docebo user profiles with their corresponding Facebook accounts! Every user will be able to sign in Docebo without having to authenticate manually via user and password.]]></source>
		<target><![CDATA[Esta aplicación permite vincular todos os perfís de usuarios de Docebo coas súas correspondentes contas de Facebook. Cada usuario poderá iniciar sesión en Docebo sen ter que autenticarse manualmente mediante usuario e contrasinal.]]></target>
	</trans-unit>
