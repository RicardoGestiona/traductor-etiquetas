		<target><![CDATA[Modalidade de visualización]]></target>
	</trans-unit>
	<trans-unit id="Display a welcome page that will contain the catalog in the my course area" extradata="CoursecatalogApp">
		<source><![CDATA[Allow My courses and Catalog in the same page]]></source>
		<target><![CDATA[Permitir os meus cursos e o catálogo na mesma páxina]]></target>
	</trans-unit>
