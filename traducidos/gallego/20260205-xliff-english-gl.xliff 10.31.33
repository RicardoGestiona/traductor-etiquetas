	<trans-unit id="When the focus mode is active, the Syllabus visibility and Theater mode navigation settings are not applied and the Course autoplay is always on." extradata="standard">
		<source><![CDATA[When the focus mode is active, the Syllabus visibility and Theater mode navigation settings are not applied and the Course autoplay is always on.]]></source>
		<target><![CDATA[Cando o modo de enfoque está activo, a visibilidade do programa e a configuración de navegación do modo Teatro non se aplican e a reprodución automática do curso está sempre activada.]]></target>
	</trans-unit>
	<trans-unit id="When the focus mode is enabled, the Theater Navigation is not available" extradata="standard">
		<source><![CDATA[When the focus mode is enabled, the theater navigation is not available]]></source>
		<target><![CDATA[Cando o modo de enfoque está activado, a navegación no teatro non está dispoñible]]></target>
	</trans-unit>
	<trans-unit id="When the focus mode is enabled, the autoplay of the course is always on" extradata="standard">
		<source><![CDATA[When the focus mode is enabled, the autoplay of the course is always on]]></source>
		<target><![CDATA[Cando o modo de enfoque está activado, a reprodución automática do curso está sempre activada]]></target>
	</trans-unit>
	<trans-unit id="When the focus mode is enabled, the syllabus visibility setting is disabled" extradata="standard">
