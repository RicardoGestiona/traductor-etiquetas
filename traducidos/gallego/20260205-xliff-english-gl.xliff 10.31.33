		<target><![CDATA[Necesitas axuda? &lt;br /&gt;&lt;a href=&quot;{contacta connosco}&quot; onclick=&quot;window.open(this.href);return false;&quot;&gt;Ponte en contacto co noso equipo&lt;/a&gt;]]></target>
