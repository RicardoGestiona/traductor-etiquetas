		<target><![CDATA[O dominio debe estar entre o segundo e o quinto nivel]]></target>
	</trans-unit>
	<trans-unit id="Domain must be between second and fifth level (example of a third-level domain: subdomain.yourcompany.com or www.yourcompany.com). Special characters and capital letters are not accepted." extradata="domains">
		<source><![CDATA[Domain must be between second and fifth level (example of a third-level domain: subdomain.yourcompany.com or www.yourcompany.com). Special characters and capital letters are not accepted.]]></source>
		<target><![CDATA[O dominio debe estar entre o segundo e o quinto nivel (exemplo dun dominio de terceiro nivel: subdominio.a túaempresa.com ou www.a túaempresa.com). Non se aceptan caracteres especiais nin maiúsculas.]]></target>
	</trans-unit>
	<trans-unit id="Domain must be between third and fifth level" extradata="domains">
		<source><![CDATA[Domain must be between third and fifth level]]></source>
		<target><![CDATA[O dominio debe estar entre o terceiro e o quinto nivel]]></target>
	</trans-unit>
