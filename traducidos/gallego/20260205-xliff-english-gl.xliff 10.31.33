	<trans-unit id="Activating this option grants Superadmins and Power Users access to the Help button. Place your Zendesk chatbox on the left to avoid overlapping with the platform's Help center chatbox on the right." extradata="ZendeskApp">
		<source><![CDATA[Activating this option grants Superadmins and Power Users access to the Help button. Place your Zendesk chatbox on the left to avoid overlapping with the platform's Help center chatbox on the right.]]></source>
		<target><![CDATA[Ao activar esta opción, os superadministradores e os usuarios avanzados teñen acceso ao botón Axuda. Coloca a túa caixa de chat de Zendesk á esquerda para evitar que se solape coa caixa de chat do Centro de axuda da plataforma á dereita.]]></target>
	</trans-unit>
	<trans-unit id="Activating this option will allow Superadmins and Power Users to access the help button" extradata="ZendeskApp">
		<source><![CDATA[Activating this option will allow Superadmins and Power Users to access the Help button]]></source>
		<target><![CDATA[Ao activar esta opción, os superadministradores e os usuarios avanzados poderán acceder ao botón Axuda]]></target>
	</trans-unit>
	<trans-unit id="Activating this option will allow non-authenticated users to access the Help button" extradata="ZendeskApp">
		<source><![CDATA[Activating this option will allow non-authenticated users to access the Help button]]></source>
		<target><![CDATA[Ao activar esta opción, os usuarios non autenticados poderán acceder ao botón Axuda]]></target>
	</trans-unit>
